    "Steadymic keeps running. To show the icon again, open Steadymic from the Applications folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic läuft weiter. Zum erneuten Anzeigen des Symbols Steadymic im Ordner „Programme“ öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic sigue funcionando. Para volver a mostrar el icono, abre Steadymic desde la carpeta Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic continue de fonctionner. Pour afficher à nouveau l’icône, ouvrez Steadymic depuis le dossier Applications."
