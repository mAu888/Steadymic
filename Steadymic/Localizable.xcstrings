    "You selected %@, but Steadymic switched the input back. “Set as Forced Input” makes %@ the new pinned input instead." : {
      "comment" : "Notification body. Both arguments are the same device name. The quoted phrase must match the translation of “Set as Forced Input”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde ausgewählt, aber Steadymic hat den Eingang zurückgestellt. „Als festen Eingang verwenden“ macht stattdessen %2$@ zum neuen festen Eingang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionaste %1$@, pero Steadymic volvió a cambiar la entrada. «Establecer como entrada forzada» hace que %2$@ sea la nueva entrada fija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez choisi %1$@, mais Steadymic a rebasculé l’entrée. « Définir comme entrée forcée » fait de %2$@ la nouvelle entrée fixe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato %1$@, ma Steadymic ha ripristinato l’ingresso. «Imposta come ingresso forzato» rende %2$@ il nuovo ingresso fisso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você selecionou %1$@, mas o Steadymic reverteu a entrada. “Definir como entrada forçada” torna %2$@ a nova entrada fixa."
          }
        }
      }
    }
  },
  "version" : "1.0"
