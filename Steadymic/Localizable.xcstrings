    "Steadymic" : {
      "comment" : "Accessibility description of the menu bar icon. The app name, not translated.",
      "shouldTranslate" : false
    },
    "Steadymic could not switch the input to %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic konnte den Eingang nicht auf %@ umstellen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic no pudo cambiar la entrada a %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic n’a pas pu basculer l’entrée sur %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic non è riuscito a passare l’ingresso a %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Steadymic não conseguiu mudar a entrada para %@"
          }
        }
      }
    },
    "Steadymic forces the default input to the first connected device below, falling back to the built-in microphone when none of them are connected. Choosing a single input from the menu turns the chain off and keeps this list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic legt den Standardeingang auf das erste verbundene Gerät unten fest und greift auf das integrierte Mikrofon zurück, wenn keines davon verbunden ist. Die Auswahl eines einzelnen Eingangs im Menü deaktiviert die Liste, sie bleibt aber erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic fuerza la entrada predeterminada al primer dispositivo conectado de la lista y recurre al micrófono integrado si no hay ninguno conectado. Al elegir una sola entrada en el menú, la lista se desactiva, pero se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic force l’entrée par défaut sur le premier périphérique connecté ci-dessous, et revient au micro intégré lorsqu’aucun n’est connecté. Choisir une seule entrée dans le menu désactive la liste et la conserve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steadymic forza l’ingresso predefinito sul primo dispositivo collegato qui sotto e, se nessuno è collegato, ricorre al microfono integrato. Scegliendo un singolo ingresso dal menu, l’elenco viene disattivato ma conservato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Steadymic força a entrada padrão para o primeiro dispositivo conectado abaixo e usa o microfone embutido quando nenhum deles está conectado. Escolher uma única entrada no menu desativa a lista, mas a mantém."
          }
        }
      }
    },
